# Generated by Terraform — do not edit manually.
# To regenerate: terraform apply, then scp or terraform output -raw rendered_env

# ── Database ────────────────────────────────────────────
DB_PASSWORD=${db_password}
DATABASE_URL=postgresql+asyncpg://app:${db_password}@postgres:5432/projectspace
LITELLM_DATABASE_URL=postgresql://app:${db_password}@postgres:5432/projectspace

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=${jwt_secret}
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── MinIO (S3-compatible file storage) ──────────────────
MINIO_ACCESS_KEY=${minio_access_key}
MINIO_SECRET_KEY=${minio_secret_key}
MINIO_URL=minio:9000

# ── LLM ─────────────────────────────────────────────────
LLM_MODEL=${llm_model}
EMBEDDING_MODEL=${embedding_model}
OLLAMA_URL=${ollama_url}

# ── LLM Gateway (LiteLLM) ──────────────────────────────
LLM_GATEWAY_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=${litellm_master_key}

# ── Anthropic (optional paid provider passthrough) ──────
ANTHROPIC_API_KEY=${anthropic_api_key}

# ── Service URLs ────────────────────────────────────────
STT_URL=http://parakeet:5092
REDIS_URL=redis://redis:6379/0

# ── Domain ──────────────────────────────────────────────
DOMAIN=${domain}
