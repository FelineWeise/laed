# =============================================================================
# Copy this file to terraform.tfvars (or <project>.tfvars) and fill in values.
# Usage: terraform apply -var-file=<project>.tfvars
# =============================================================================

# -- Identity ----------------------------------------------------------------
project_name = "myproject"
domain       = "myproject.eu"

# -- Scaleway credentials ----------------------------------------------------
scw_access_key = ""
scw_secret_key = ""
scw_project_id = ""
scw_region     = "fr-par"
scw_zone       = "fr-par-1"

# -- Base instance -----------------------------------------------------------
base_instance_type  = "GP1-XS"
base_image          = "ubuntu_noble"
base_volume_size_gb = 100
base_volume_iops    = 5000

# -- GPU instance (set gpu_enabled = true to provision) ----------------------
gpu_enabled        = false
gpu_instance_type  = "L4-1-24G"
gpu_image          = "ubuntu_noble_gpu"
gpu_zone           = "fr-par-1"
gpu_volume_size_gb = 125
gpu_volume_iops    = 5000

# -- Self-hosted models ------------------------------------------------------
llm_model       = "qwen2.5:14b-instruct-q4_K_M"
embedding_model = "nomic-embed-text"

# -- SSH keys (list your Scaleway SSH key IDs) --------------------------------
ssh_key_ids = []

# -- Optional: Tailscale mesh VPN (leave empty to skip) ----------------------
tailscale_auth_key = ""

# -- Optional: DNS management (only if NS points to Scaleway) ----------------
manage_dns = false

# -- Optional: Git repo to clone on base server ------------------------------
repo_url = ""

# -- Optional: Anthropic API key for LiteLLM paid-provider passthrough -------
anthropic_api_key = ""
