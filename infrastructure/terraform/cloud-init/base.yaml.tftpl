#cloud-config

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - git
  - ufw

runcmd:
  # ── Docker CE + Compose ──────────────────────────────────────────────
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  - chmod a+r /etc/apt/keyrings/docker.gpg
  - |
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
    https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  # ── Mount block volume (must happen before writing config files) ─────
  - mkdir -p /opt/${project_name}-data
  - |
    BLOCK_DEV=$(lsblk -dpno NAME,TYPE | grep disk | tail -1 | awk '{print $1}')
    if [ -n "$BLOCK_DEV" ] && ! blkid "$BLOCK_DEV" | grep -q ext4; then
      mkfs.ext4 "$BLOCK_DEV"
    fi
    if [ -n "$BLOCK_DEV" ]; then
      mount "$BLOCK_DEV" /opt/${project_name}-data
      echo "$BLOCK_DEV /opt/${project_name}-data ext4 defaults,nofail 0 2" >> /etc/fstab
    fi

  # ── Write config files (after mount so they land on the volume) ──────
  - |
    cat > /opt/${project_name}-data/.env << 'ENVEOF'
    ${env_content}
    ENVEOF
    chmod 600 /opt/${project_name}-data/.env
  - |
    cat > /opt/${project_name}-data/litellm-config.yaml << 'LITELLMEOF'
    ${litellm_config}
    LITELLMEOF
    chmod 600 /opt/${project_name}-data/litellm-config.yaml

  # ── Scaleway Container Registry auth ─────────────────────────────────
  - |
    mkdir -p /root/.docker
    echo '{"auths":{"rg.${scw_region}.scw.cloud":{"auth":"'$(echo -n "${scw_access_key}:${scw_secret_key}" | base64)'"}}}' \
      > /root/.docker/config.json
    chmod 600 /root/.docker/config.json

  # ── Clone project repo (optional) ───────────────────────────────────
%{ if repo_url != "" ~}
  - git clone ${repo_url} /opt/${project_name}-data/repo
%{ endif ~}

  # ── Firewall ────────────────────────────────────────────────────────
  - ufw allow OpenSSH
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable

  # ── Tailscale (optional) ────────────────────────────────────────────
%{ if tailscale_auth_key != "" ~}
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --authkey=${tailscale_auth_key} --ssh
%{ endif ~}
