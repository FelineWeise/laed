# Copy to laed-base as /etc/default/laed-gpu-control (root:root, chmod 600) and fill in.
# Install only on Ubuntu/Debian (host must have /etc/default/). Then:
#   sudo laed-base-gpu-poweron.sh

SCW_ACCESS_KEY=
SCW_SECRET_KEY=
# Required for `scw` CLI poweron path. Console: https://console.scaleway.com/organization/settings
SCW_DEFAULT_ORGANIZATION_ID=
SCW_DEFAULT_PROJECT_ID=

GPU_ZONE=fr-par-2
GPU_SERVER_ID=
