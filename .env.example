# ── Database ────────────────────────────────────────────
DB_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── MinIO (S3-compatible file storage) ──────────────────
MINIO_ACCESS_KEY=changeme-generate-with-openssl-rand-hex-20
MINIO_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# ── LLM ─────────────────────────────────────────────────
LLM_MODEL=laed-chat
EMBEDDING_MODEL=laed-embed
OLLAMA_URL=http://172.16.16.3:11434

# ── LLM Gateway (LiteLLM) ──────────────────────────────
LLM_GATEWAY_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=changeme-generate-with-openssl-rand-hex-32
# OpenAI-compatible gateway origin only (litellm-config appends /v1 for laed-fallback).
THIRDPARTY_LITELLM_URL=https://ai-gateway.eraneos.com
THIRDPARTY_LITELLM_KEY=changeme-thirdparty-gateway-key

# ── Anthropic (for OpenClaw / dev assistant) ────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Service URLs ────────────────────────────────────────
STT_URL=http://parakeet:5092
MINIO_URL=minio:9000
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://app:${DB_PASSWORD}@postgres:5432/projectspace
LITELLM_DATABASE_URL=postgresql://app:${DB_PASSWORD}@postgres:5432/projectspace

# ── Domain ──────────────────────────────────────────────
DOMAIN=laed.eu

# ── OpenClaw / Admin ────────────────────────────────────
OPENCLAW_GATEWAY_TOKEN=changeme-generate-with-openssl-rand-hex-32
# Telegram (BotFather): full token id:secret — used when channels.telegram.botToken references TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=
ADMIN_USER=admin
ADMIN_PASS_HASH=changeme-generate-with-caddy-hash-password
DOCKER_GID=999
