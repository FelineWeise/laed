# ── Database ────────────────────────────────────────────
DB_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── MinIO (S3-compatible file storage) ──────────────────
MINIO_ACCESS_KEY=changeme-generate-with-openssl-rand-hex-20
MINIO_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32

# ── LLM (via shared LiteLLM gateway; model ids must exist in llm-gateway/litellm-config.yaml) ──
LLM_MODEL=ollama/qwen3:14b-instruct
EMBEDDING_MODEL=ollama/nomic-embed-text

# Dedicated RAG Postgres (same instance as DATABASE_URL; separate DB `rag` + user `rag`).
# Bootstrap: llm-gateway/scripts/bootstrap_rag_db.sql then llm-gateway/alembic/versions/20260507_02_rag_schema.sql
# Use hostname `postgres` from LAED app/worker containers (not host.docker.internal).
RAG_DATABASE_URL=postgresql+asyncpg://rag:changeme-rag-password@postgres:5432/rag
# Must match llm-gateway/scripts/seed_laed_rag.sql tenant id
LAED_TENANT_ID=b0000001-0000-4000-8000-000000000001

# Demo login (ensured on every app startup; leave LAED_DEMO_EMAIL empty to disable)
LAED_DEMO_EMAIL=demo@laed.local
LAED_DEMO_PASSWORD=changeme-demo-password
LAED_DEMO_DISPLAY_NAME=Demo User

# Optional frontend build hint (email only — set when building frontend image)
# NEXT_PUBLIC_DEMO_EMAIL=demo@laed.local

# ── Scaleway registry push (Mac → CR; pin on server after push) ──
# SCW_SECRET_KEY=<API secret UUID — not the SCW... access key>
# SCW_PROJECT_ID=<project UUID — required for ensure_scaleway_registry.sh>
# SCW_REGISTRY_NAMESPACE=laed
# LAED_REGISTRY_IMAGES="backend frontend parakeet"
# SCW_IMAGE_BACKEND=backend
# SCW_IMAGE_FRONTEND=frontend
# LAED_BACKEND_IMAGE=rg.fr-par.scw.cloud/laed/backend:<tag-or-digest>
# LAED_FRONTEND_IMAGE=rg.fr-par.scw.cloud/laed/frontend:<tag-or-digest>
# DEPLOY_REMOTE=scw-base
# DEPLOY_DATA_DIR=/opt/laed

# ── LLM Gateway (LiteLLM) ──────────────────────────────
# OpenAI-compatible compatibility names (shared consumer contract):
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=${LITELLM_MASTER_KEY}
# Backend-native names (kept for compatibility):
LLM_GATEWAY_URL=http://litellm:4000/v1
LLM_GATEWAY_KEY=${LITELLM_MASTER_KEY}
LITELLM_MASTER_KEY=changeme-must-match-llm-gateway-LITELLM_MASTER_KEY
# GPU / Scaleway / OLLAMA_URL live only in sibling repo `llm-gateway/.env`.
# Terraform: `terraform output -raw gpu_private_ip` feeds `llm-gateway` OLLAMA_URL (not required here).

# ── Anthropic (for OpenClaw / dev assistant) ────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Service URLs ────────────────────────────────────────
STT_URL=http://parakeet:5092
MINIO_URL=minio:9000
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://app:${DB_PASSWORD}@postgres:5432/projectspace

# ── Domain ──────────────────────────────────────────────
DOMAIN=laed.eu

# ── Caddy admin (admin.laed.eu / litellm.laed.eu) ───────
# Copy caddy.auth.env.example → caddy.auth.env (do not put ADMIN_PASS_HASH in this file).
