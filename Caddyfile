{$DOMAIN} {
    handle /api/* {
        reverse_proxy app:8000
    }
    handle /ws/* {
        reverse_proxy app:8000
    }
    handle /sse/* {
        reverse_proxy app:8000
    }
    # When frontend is enabled, uncomment below and remove the catch-all to app:
    # handle {
    #     reverse_proxy frontend:3000
    # }
    handle {
        reverse_proxy app:8000
    }
}
